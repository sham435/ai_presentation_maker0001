{
  "name": "ai-presentation-maker-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AI Presentation Maker - desktop stack (Electron + React + TypeScript)",
  "main": "out/main/index.js",
  "author": "MyAI",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node scripts/smoke-build.mjs && vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests tests/integration",
    "test:e2e": "vitest run --passWithNoTests tests/e2e",
    "test:visual": "vitest run --passWithNoTests tests/visual",
    "eval:live": "vitest run --passWithNoTests tests/eval/live",
    "verify": "npm run typecheck && npm run build && npm run test",
    "verify:all": "npm run verify && npm run lint && npm run test:integration && npm run test:e2e && npm run test:visual",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "dompurify": "^3.2.4",
    "electron-updater": "^6.3.9",
    "jsdom": "^26.0.0",
    "nanoid": "^5.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^9.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
